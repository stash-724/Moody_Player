PORT=3000

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/moody_player

# ImageKit credentials (audio file storage)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>

# Secret required in the x-admin-key header for POST /songs.
# Leave empty to disable uploads entirely.
ADMIN_API_KEY=

# Comma-separated list of allowed frontend origins. Unset = allow all (local dev only).
CORS_ORIGIN=http://localhost:5173

{
  "info": {
    "name": "Moody Player API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ],
          "query": []
        }
      }
    },
    {
      "name": "GET songs ranked by valence/energy distance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns the mood target point', () => { pm.expect(body.target).to.have.keys('valence', 'energy'); });",
              "pm.test('at most 10 songs by default', () => pm.expect(body.songs.length).to.be.at.most(10));",
              "pm.test('sorted by ascending distance', () => { const d = body.songs.map(s => s.distance); pm.expect(d).to.eql([...d].sort((a, b) => a - b)); });",
              "pm.test('distance matches valence/energy', () => body.songs.forEach(s => pm.expect(s.distance).to.be.closeTo(Math.hypot(s.valence - body.target.valence, s.energy - body.target.energy), 0.001)));",
              "pm.test('songs carry licence info', () => body.songs.forEach(s => pm.expect(s).to.have.property('license')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/songs?mood=happy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": [
            {
              "key": "mood",
              "value": "happy"
            }
          ]
        }
      }
    },
    {
      "name": "GET songs with limit=3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with exactly 3 songs', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().songs.length).to.eql(3); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/songs?mood=fear&limit=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": [
            {
              "key": "mood",
              "value": "fear"
            },
            {
              "key": "limit",
              "value": "3"
            }
          ]
        }
      }
    },
    {
      "name": "GET songs with invalid limit -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/songs?mood=sad&limit=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": [
            {
              "key": "mood",
              "value": "sad"
            },
            {
              "key": "limit",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "name": "GET songs without mood -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/songs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": []
        }
      }
    },
    {
      "name": "GET songs with invalid mood -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/songs?mood=sleepy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": [
            {
              "key": "mood",
              "value": "sleepy"
            }
          ]
        }
      }
    },
    {
      "name": "POST song without admin key -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]

      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/does-not-exist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "does-not-exist"
          ],
          "query": []
        }
      }
    }
  ]

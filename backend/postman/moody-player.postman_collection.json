      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/songs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": []
        }
      }
    },
    {
      "name": "POST song with wrong admin key -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-admin-key",
            "value": "definitely-wrong"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/songs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": []
        }
      }
    },
    {
      "name": "POST song with valid key but no data -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 with field errors', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors.length).to.be.above(0); });",
              "pm.test('rejects out-of-range valence and missing energy', () => { const e = pm.response.json().errors.join(' '); pm.expect(e).to.include('valence'); pm.expect(e).to.include('energy'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-admin-key",
            "value": "{{adminKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/songs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "songs"
          ],
          "query": []
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "mood",
              "value": "happy",
              "type": "text"
            },
            {
              "key": "valence",
              "value": "1.7",
              "type": "text"
            }
          ]
        }
      }
    },
    {
